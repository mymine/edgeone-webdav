{
  "nodeVersion": "20.18.0",
  "outputDirectory": "public",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/dav/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ping",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
